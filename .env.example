# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (server-side only — never expose to the client)
ANTHROPIC_API_KEY=sk-ant-...
# Model used for grounded generation + explanations. Swap without code changes.
AI_MODEL=claude-haiku-4-5
# Generations included per month for premium users
AI_MONTHLY_INCLUDED=30

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Business config
# Price of a semester unlock, in kobo (100000 = ₦1,000)
SEMESTER_PRICE_KOBO=100000
NEXT_PUBLIC_SEMESTER_PRICE_NAIRA=1000
# Current semester label stamped on new unlocks
SEMESTER_LABEL=2024/2025 Rain
# Class-rep commission percentage
REP_COMMISSION_PERCENT=15
# Referral anti-abuse: max rewarded referrals per referrer per month
REFERRAL_MONTHLY_CAP=10
# WhatsApp number for "paid by transfer" fallback (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
